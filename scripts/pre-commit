#!/usr/bin/env bash
# Pre-commit hook: valida los YAML de recetas/, ingredientes/ y plan/ antes
# de permitir el commit, generando el sitio en un directorio temporal (no
# toca docs/). Instálalo con scripts/install-hooks.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACM)
yaml_staged=$(echo "$staged" | grep -E '^(recetas|ingredientes|plan)/.*\.yaml$' || true)

if [ -z "$yaml_staged" ]; then
    exit 0
fi

echo "Validando YAML antes de comitear..."

while IFS= read -r f; do
    python3 -c "import sys, yaml; yaml.safe_load(open(sys.argv[1], encoding='utf-8'))" "$f" || {
        echo "YAML inválido: $f" >&2
        exit 1
    }
done <<< "$yaml_staged"

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT
if ! python3 scripts/generate_site.py --output "$tmp_dir"; then
    echo "generate_site.py ha fallado con los YAML actuales; revisa el error antes de comitear." >&2
    exit 1
fi
